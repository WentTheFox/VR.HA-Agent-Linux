[Unit]
Description=Home Assistant Agent for VR
Documentation=https://github.com/WentTheFox/VR.HA-Agent-Linux
# Started with the desktop session so the window and tray icon can appear. On a machine without a
# graphical session, change WantedBy to default.target; the agent then runs without its UI.
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=@EXEC@
# Exiting from the window or tray is a clean exit and stays stopped, like closing the app on Windows.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
