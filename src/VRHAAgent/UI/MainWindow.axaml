<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="VRHAAgent.UI.MainWindow"
        Title="Home Assistant Agent for VR"
        Icon="/Assets/icon.png"
        Width="680" Height="480"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <ui:FANavigationView x:Name="NavigationViewControl"
                         PaneDisplayMode="Top"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="True"
                         SelectionChanged="NavigationViewControl_OnSelectionChanged">
        <ui:FANavigationView.MenuItems>
            <ui:FANavigationViewItem Content="Home" Tag="Home" IconSource="Library" />
            <ui:FANavigationViewItem Content="Notification editor" Tag="NotificationEditor" IconSource="Message" />
        </ui:FANavigationView.MenuItems>
    </ui:FANavigationView>
</Window>
